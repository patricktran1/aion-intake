# AION Intake — environment.
#
# Copy to .env.local and fill in. NO REAL CREDENTIALS BELONG IN THIS FILE or in
# version control. Every value here is a placeholder or a local-development
# value, and pilot mode rejects the well-known placeholders on purpose.

# ── Mode ──────────────────────────────────────────────────────────────────
# "demo"  synthetic data in process memory (the public demo). The default.
# "pilot" durable Postgres, clinician accounts, audit, object storage.
# Never inferred: an unrecognised value is a startup error.
AION_RUNTIME_MODE=demo

# ── Demo mode ─────────────────────────────────────────────────────────────
# Shared passphrase for the demo's clinician view. Not authentication, and not
# claimed to be. Leave unset and the demo's clinician view is open.
# CLINICIAN_ACCESS_CODE=

# ── Pilot mode (all required when AION_RUNTIME_MODE=pilot) ────────────────
# Postgres connection string, or pglite:<dir> for local development only.
# Setting this in demo mode is a startup error, so a pilot database cannot be
# reached by a public demo through one stray variable.
# DATABASE_URL=postgres://user:password@host:5432/aion

# 32+ characters each, and different from one another. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating the pepper invalidates every outstanding patient link — that is the
# emergency lever, and it is worth knowing it works that way before you need it.
# AION_SESSION_SECRET=
# AION_TOKEN_PEPPER=

# Object storage: "local" (a mounted encrypted volume) or "s3" (any
# S3-compatible provider). The bucket MUST be private.
# AION_OBJECT_STORE=local
# AION_OBJECT_STORE_ROOT=/var/lib/aion/objects
# AION_OBJECT_STORE=s3
# AION_S3_BUCKET=
# AION_S3_REGION=
# AION_S3_ACCESS_KEY_ID=
# AION_S3_SECRET_ACCESS_KEY=
# AION_S3_ENDPOINT=            # only for non-AWS providers

# Retention, in days. Required — there is no safe default to invent, and the
# lawful value is a decision for counsel, not for this file.
# AION_PHOTO_RETENTION_DAYS=30
# AION_INTAKE_RETENTION_DAYS=90

# How long a patient's intake link stays valid. Default 72.
# AION_PATIENT_TOKEN_TTL_HOURS=72

# ── Model provider (optional in both modes) ───────────────────────────────
# With no key the product runs fully deterministically and no patient text
# leaves the deployment. With a key, patient answers are sent to Anthropic —
# a BAA must be in place first. See MODEL_EVAL.md and PRIVACY_MAP.md.
# ANTHROPIC_API_KEY=
# AION_MODEL_MODE=full         # off | facts | turn | hpi | full
# AION_MODEL=claude-haiku-4-5

# ── Development ───────────────────────────────────────────────────────────
# AION_LOG_ANALYTICS=0         # silence structured logs in local scripts
