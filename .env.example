# Optional. Without it, AION Intake runs on its deterministic interview engine
# (zero AI cost, fully functional demo). With it, the same engine gains
# LLM-backed extraction, question phrasing, and drafting.
ANTHROPIC_API_KEY=

# Model used for every AI call. One small model, deliberately.
AION_MODEL=claude-haiku-4-5

# Shared passphrase for the clinician view in the demo deployment.
# Leave unset to leave the demo clinician view open (synthetic data only).
CLINICIAN_ACCESS_CODE=
