{
  "name": "aion-intake",
  "version": "0.1.0",
  "private": true,
  "description": "AION Intake \u2014 pre-visit intelligence for dermatology.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run eval:gate",
    "eval": "tsx evals/run.ts",
    "eval:golden": "tsx evals/run.ts --golden",
    "eval:write": "tsx evals/run.ts --write",
    "eval:baseline": "tsx evals/run.ts --baseline",
    "eval:gate": "tsx evals/gate.ts",
    "eval:ablate": "tsx evals/ablate.ts",
    "cost": "tsx scripts/cost.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
